# ============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# M-Pesa Payment Integration - Charlady Platform
# 
# INSTRUCTIONS:
# 1. Copy this file to .env in the project root
# 2. Replace all placeholder values with your actual credentials
# 3. NEVER commit .env to version control
# 4. Keep .env secure and limit access
# ============================================================================

# ============================================================================
# DJANGO CONFIGURATION
# ============================================================================

# Debug mode (FALSE in production)
DEBUG=False

# Django secret key for session security (Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
SECRET_KEY=your_django_secret_key_here_replace_with_secure_key_12345678901234567890

# Allowed hosts (comma-separated, no spaces after commas)
ALLOWED_HOSTS=charlady.co.ke,www.charlady.co.ke,127.0.0.1,localhost

# Django environment (development, staging, production)
ENVIRONMENT=production

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL Database URL format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://charlady:your_postgres_password@localhost:5432/charlady_db

# Alternative PostgreSQL settings (if not using DATABASE_URL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=charlady_db
DB_USER=charlady
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432

# Database Connection Pool
DB_CONN_MAX_AGE=600
DB_ATOMIC_REQUESTS=True

# ============================================================================
# M-PESA CONFIGURATION (SANDBOX)
# ============================================================================

# M-Pesa environment (sandbox or production)
MPESA_ENVIRONMENT=sandbox

# Sandbox Consumer Key (Get from https://developer.safaricom.co.ke/)
MPESA_CONSUMER_KEY_SANDBOX=DU68PrjYY2nEYvXA5Eq2GyoL4c7LQwN8i8X01aGyRQp6zGjD

# Sandbox Consumer Secret
MPESA_CONSUMER_SECRET_SANDBOX=your_sandbox_consumer_secret_here

# Sandbox Passkey (for password generation in STK push)
MPESA_PASSKEY_SANDBOX=bfb279f9ba9b9d8c25f1c0e1c5f54987b51e1dd45e2c6c0e4f4f8c1f8f9b9e8c

# Sandbox Short Code (4564139 is test code, get production from M-Pesa)
MPESA_SHORT_CODE_SANDBOX=4564139

# Sandbox Business Type (DefaultAccount)
MPESA_BUSINESS_TYPE_SANDBOX=DefaultAccount

# Sandbox API Endpoint
MPESA_API_ENDPOINT_SANDBOX=https://sandbox.safaricom.co.ke

# ============================================================================
# M-PESA CONFIGURATION (PRODUCTION)
# ============================================================================
# NOTE: Fill these after getting production credentials from Safaricom

# Production Consumer Key (Get from Safaricom)
MPESA_CONSUMER_KEY_PRODUCTION=your_production_consumer_key_here

# Production Consumer Secret
MPESA_CONSUMER_SECRET_PRODUCTION=your_production_consumer_secret_here

# Production Passkey
MPESA_PASSKEY_PRODUCTION=your_production_passkey_here

# Production Short Code (Get from Safaricom)
MPESA_SHORT_CODE_PRODUCTION=123456

# Production Business Type
MPESA_BUSINESS_TYPE_PRODUCTION=DefaultAccount

# Production API Endpoint
MPESA_API_ENDPOINT_PRODUCTION=https://api.safaricom.co.ke

# ============================================================================
# M-PESA BUSINESS SETTINGS
# ============================================================================

# B2C Originator Converstion ID (for M-Pesa reversal)
MPESA_ORIGINATOR_CONVERSATION_ID=your_originator_conversation_id

# Queue timeout (milliseconds)
MPESA_QUEUE_TIMEOUT_URL=https://charlady.co.ke/payments/queue-timeout/
MPESA_RESULT_URL=https://charlady.co.ke/payments/mpesa-result/

# Payment callback URL
MPESA_CALLBACK_URL=https://charlady.co.ke/payments/mpesa-callback/

# M-Pesa IP whitelist (comma-separated, add production IPs when available)
MPESA_ALLOWED_IPS=196.201.214.192,196.201.214.206,127.0.0.1

# ============================================================================
# PAYMENT CONFIGURATION
# ============================================================================

# Default currency
CURRENCY=KES

# Payment timeout in minutes (auto-fail if not completed)
PAYMENT_TIMEOUT_MINUTES=5

# Verification badge cost (KES)
VERIFICATION_BADGE_COST=250

# Verification badge validity (days)
VERIFICATION_BADGE_VALIDITY_DAYS=365

# Monthly contribution percentage
MONTHLY_CONTRIBUTION_PERCENTAGE=3

# Minimum monthly contribution amount (KES)
MONTHLY_CONTRIBUTION_MINIMUM=100

# ============================================================================
# REDIS CONFIGURATION (for Celery)
# ============================================================================

# Redis URL (format: redis://[:password]@host:port/db)
REDIS_URL=redis://localhost:6379/0

# Celery Broker URL (same as Redis for this setup)
CELERY_BROKER_URL=redis://localhost:6379/0

# Celery Result Backend (same as Redis)
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Redis connection pool size
REDIS_CONNECTION_POOL_SIZE=50

# Redis socket timeout (seconds)
REDIS_SOCKET_TIMEOUT=5

# Redis socket connect timeout (seconds)
REDIS_SOCKET_CONNECT_TIMEOUT=5

# ============================================================================
# CELERY CONFIGURATION
# ============================================================================

# Celery broker connection URL
CELERY_BROKER_CONNECTION_RETRY_ON_STARTUP=True

# Celery task time limit (seconds)
CELERY_TASK_TIME_LIMIT=1800

# Celery task soft time limit (seconds)
CELERY_TASK_SOFT_TIME_LIMIT=1500

# Celery task track started
CELERY_TASK_TRACK_STARTED=True

# Celery result expiry time (seconds)
CELERY_RESULT_EXPIRES=3600

# Celery timezone
CELERY_TIMEZONE=Africa/Nairobi

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================

# Email backend (smtp or console for testing)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# SMTP Server
EMAIL_HOST=smtp.gmail.com

# SMTP Port (587 for TLS, 465 for SSL)
EMAIL_PORT=587

# SMTP Username (Gmail: your-email@gmail.com)
EMAIL_HOST_USER=your_email@gmail.com

# SMTP Password (Gmail App Password, NOT your main password)
EMAIL_HOST_PASSWORD=your_app_specific_password

# SMTP TLS
EMAIL_USE_TLS=True

# Email from address
DEFAULT_FROM_EMAIL=noreply@charlady.co.ke

# Admin email for error notifications
ADMIN_EMAIL=admin@charlady.co.ke

# ============================================================================
# AWS S3 CONFIGURATION (for file uploads)
# ============================================================================

# AWS Access Key ID
AWS_ACCESS_KEY_ID=your_aws_access_key_id

# AWS Secret Access Key
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# AWS S3 Bucket Name
AWS_STORAGE_BUCKET_NAME=charlady-media-bucket

# AWS S3 Region
AWS_S3_REGION_NAME=eu-west-1

# AWS S3 Custom Domain
AWS_S3_CUSTOM_DOMAIN=cdn.charlady.co.ke

# AWS S3 Use SSL
AWS_S3_USE_SSL=True

# ============================================================================
# LOGGING & MONITORING
# ============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Sentry DSN for error tracking (get from https://sentry.io/)
SENTRY_DSN=https://your_sentry_key@sentry.io/project_id

# Sentry environment
SENTRY_ENVIRONMENT=production

# ============================================================================
# SECURITY SETTINGS
# ============================================================================

# HTTPS settings
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# HSTS settings (Strict-Transport-Security)
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Security headers
SECURE_BROWSER_XSS_FILTER=True
SECURE_CONTENT_SECURITY_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline';

# X-Frame-Options for clickjacking protection
X_FRAME_OPTIONS=DENY

# ============================================================================
# AUTHENTICATION & SOCIAL LOGIN
# ============================================================================

# Google OAuth2 Credentials (for user registration)
GOOGLE_OAUTH2_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_OAUTH2_CLIENT_SECRET=your_google_client_secret

# Facebook Credentials
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_SECRET=your_facebook_secret

# ============================================================================
# SMS/NOTIFICATION SETTINGS
# ============================================================================

# Twilio Account SID (for SMS notifications)
TWILIO_ACCOUNT_SID=your_twilio_account_sid

# Twilio Auth Token
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Twilio Phone Number
TWILIO_PHONE_NUMBER=+1234567890

# Pesapal API Key (alternative payment provider)
PESAPAL_API_KEY=your_pesapal_api_key

# Pesapal Consumer Key
PESAPAL_CONSUMER_KEY=your_pesapal_consumer_key

# ============================================================================
# THIRD-PARTY SERVICES
# ============================================================================

# Google Analytics Tracking ID
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X

# Stripe API Key (for future implementation)
STRIPE_PUBLIC_KEY=pk_live_your_stripe_public_key
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key

# PayPal Client ID
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_SECRET=your_paypal_secret

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

# Site name
SITE_NAME=Charlady

# Site domain
SITE_DOMAIN=charlady.co.ke

# Support email
SUPPORT_EMAIL=support@charlady.co.ke

# Support phone
SUPPORT_PHONE=+254712345678

# API Rate Limit (requests per hour)
API_RATE_LIMIT=1000

# Session timeout (minutes)
SESSION_TIMEOUT=1440

# ============================================================================
# BACKGROUND TASK CONFIGURATION
# ============================================================================

# Enable/disable background tasks
ENABLE_BACKGROUND_TASKS=True

# Task retry count
TASK_RETRY_COUNT=3

# Task retry delay (seconds)
TASK_RETRY_DELAY=60

# ============================================================================
# DEPLOYMENT SETTINGS
# ============================================================================

# Deployment platform (heroku, render, digital_ocean, aws, local)
DEPLOYMENT_PLATFORM=local

# Gunicorn workers (4 × CPU cores)
GUNICORN_WORKERS=4

# Gunicorn worker timeout (seconds)
GUNICORN_WORKER_TIMEOUT=120

# Port to run on
PORT=8000

# ============================================================================
# TESTING CONFIGURATION
# ============================================================================

# Test database (set to same as DB_NAME for tests, or test_charlady_db)
TEST_DATABASE=test_charlady_db

# Enable code coverage reporting
COVERAGE_REPORT=True

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable M-Pesa payments
ENABLE_MPESA_PAYMENTS=True

# Enable worker verification system
ENABLE_WORKER_VERIFICATION=True

# Enable monthly contributions
ENABLE_MONTHLY_CONTRIBUTIONS=True

# Enable admin dashboard
ENABLE_ADMIN_DASHBOARD=True

# Enable SMS notifications
ENABLE_SMS_NOTIFICATIONS=True

# Enable email notifications
ENABLE_EMAIL_NOTIFICATIONS=True

# ============================================================================
# TIMEZONE & LOCALIZATION
# ============================================================================

# Application timezone
TIME_ZONE=Africa/Nairobi

# Language code
LANGUAGE_CODE=en-us

# Supported languages (comma-separated)
SUPPORTED_LANGUAGES=en,sw

# ============================================================================
# BACKUP & MAINTENANCE
# ============================================================================

# Database backup location
BACKUP_PATH=/backups/charlady

# Enable automated backups
ENABLE_AUTOMATED_BACKUPS=True

# Backup frequency (daily, weekly, monthly)
BACKUP_FREQUENCY=daily

# Backup retention days
BACKUP_RETENTION_DAYS=30

# ============================================================================
# DEVELOPMENT ONLY (Remove in Production)
# ============================================================================

# Allow insecure requests (development only)
INSECURE_REQUESTS=False

# Print SQL queries (development only)
PRINT_SQL_QUERIES=False

# Enable Django Debug Toolbar
DEBUG_TOOLBAR_ENABLED=False

# ============================================================================
# API KEYS & TOKENS (Third-party services)
# ============================================================================

# SendGrid API Key (alternative email provider)
SENDGRID_API_KEY=your_sendgrid_api_key

# Mailgun API Key
MAILGUN_API_KEY=your_mailgun_api_key

# Slack Bot Token (for alerts)
SLACK_BOT_TOKEN=xoxb-your-slack-token

# Slack Channel for alerts
SLACK_ALERT_CHANNEL=#payments

# ============================================================================
# END OF CONFIGURATION
# ============================================================================
# Last Updated: April 17, 2026
# Version: 1.0.0
#
# IMPORTANT REMINDERS:
# 1. NEVER commit .env to version control
# 2. Keep .env file permissions restricted (chmod 600)
# 3. Use strong, unique passwords/keys
# 4. Rotate secrets regularly
# 5. Use different credentials for sandbox/production
# 6. Document any custom variables you add
# ============================================================================
